# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Clerk Authentication (obtain from Clerk Dashboard -> Configure -> API Keys)
# Frontend Publishable Key (safe for browser via Vite VITE_ prefix)
VITE_CLERK_PUBLISHABLE_KEY=

# Backend Publishable & Secret Keys (server-side only; NEVER prefix CLERK_SECRET_KEY with VITE_)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Paystack Payment Gateway (obtain from Paystack Dashboard -> Settings -> API Keys & Webhooks)
# Server-side Secret Key (NEVER prefix with VITE_ or commit to source code)
PAYSTACK_SECRET_KEY=

# Optional Client-side Paystack Public Key
VITE_PAYSTACK_PUBLIC_KEY=

# Supabase Database & Storage (obtain from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stage 2/3 Explicit Admin Authorization (server-side only; never prefix with VITE_)
# Comma-separated Clerk user IDs and/or Clerk-verified owner emails
OWNER_CLERK_USER_IDS=
OWNER_EMAILS=
STAFF_CLERK_USER_IDS=
EASI_MARK_BOOTSTRAP_TOKEN=

